# Copy to /etc/navinix-companion.env, chmod 640, owner root:navinix.

# Required. Any long random string: openssl rand -hex 24
# This is the token you type into the app's Add tab.
COMPANION_TOKEN=change-me-to-a-long-random-string

# Required. Where finished MP3s go: the folder your media server reads. Change
# it any time, then: sudo systemctl restart navinix-companion
# The service user must be able to write here.
MUSIC_DIR=/opt/navidrome/music

# Which media server to ask for a rescan after each add: navidrome, jellyfin or
# none. Leave blank to use whichever one is filled in below.
#LIBRARY_BACKEND=

# Navidrome
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Jellyfin (Dashboard > API Keys)
#JELLYFIN_URL=http://127.0.0.1:8096
#JELLYFIN_API_KEY=

# With no server configured the file is still saved; the app just shows a
# warning, and your server finds it on its next scheduled scan.

# Optional. Absolute paths; strongly recommended with pipx (see README).
YT_DLP_PATH=/opt/navinix-companion/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
#FFMPEG_PATH=/usr/bin/ffmpeg
#WORK_DIR=/var/tmp
