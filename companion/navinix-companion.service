[Unit]
Description=Navinix companion (YouTube to MP3 for Navidrome)
After=network-online.target
Wants=network-online.target

[Service]
User=navinix
Group=navinix
WorkingDirectory=/opt/navinix-companion/app
EnvironmentFile=/etc/navinix-companion.env
ExecStart=/opt/navinix-companion/venv/bin/uvicorn app.asgi:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5

# Hardening. "full" makes /usr, /boot and /etc read-only but leaves your music
# folder (MUSIC_DIR in the env file) writable wherever it is, so changing it
# never needs an edit here. For a stricter sandbox use ProtectSystem=strict and
# add the folder: sudo systemctl edit navinix-companion
#   [Service]
#   ReadWritePaths=/your/music/folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
